# Database (PostgreSQL + pgvector)
POSTGRES_USER=ragkit
POSTGRES_PASSWORD=ragkit
POSTGRES_DB=ragkit
POSTGRES_PORT=5433
RAGKIT_DATABASE__URL=postgresql+psycopg://ragkit:ragkit@localhost:5433/ragkit

# Ollama Local Service Configuration (Host with GPU)
RAGKIT_OLLAMA__HOST=http://localhost:11434
RAGKIT_OLLAMA__LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
RAGKIT_OLLAMA__EMBED_MODEL=bge-m3

# Hardware & VRAM Tuning (RTX 3070 8GB)
TORCH_DEVICE=cuda
CUDA_VISIBLE_DEVICES=0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=10m

# Offline Hugging Face Hub (Cache for local reranker)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=./.cache/huggingface
