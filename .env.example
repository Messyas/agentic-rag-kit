# Ollama Local Service Configuration
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=
EMBED_MODEL=

# PostgreSQL + pgvector Storage
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ragkit

# Configurações de GPU & Hardware (Otimizado para RTX 3070 - 8GB VRAM)
TORCH_DEVICE=cuda
CUDA_VISIBLE_DEVICES=0
OLLAMA_NUM_GPU=999
OLLAMA_NUM_PARALLEL=1

# Offline Hugging Face Hub (Garantia de privacidade e cache local para Reranker)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=./.cache/huggingface
